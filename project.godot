; Engine configuration file.
; 《전역까지 D-100》 — Godot 4.7.x / Mobile(Vulkan) / 세로 1080x1920
; See CLAUDE.md for the project rules.

config_version=5

[application]

config/name="전역까지 D-100"
config/name_localized={
"en": "D-100 to Discharge"
}
config/description="한 판 = 전역까지 남은 100일 = 실시간 20분. 뱀파이어 서바이벌형 불릿 헤븐. 세로 화면 한 손 조작."
config/version="0.0.1"
run/main_scene="res://ui/meta/meta_root.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
AudioManager="*res://autoload/audio_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
Settings="*res://autoload/settings.gd"
ObjectPool="*res://autoload/object_pool.gd"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[display]

; 세로 한 손 조작. 1080x1920 은 흔한 폰 해상도(FHD+)의 기준이고,
; expand 라서 20:9 같은 더 긴 화면에서는 위아래가 더 보인다.
window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"pressed":false,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194320,"pressed":false,"script":null)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"pressed":false,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322,"pressed":false,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"pressed":false,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319,"pressed":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"pressed":false,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321,"pressed":false,"script":null)
]
}
toggle_debug_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334,"pressed":false,"script":null)
]
}
pause_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305,"pressed":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.ko.translation", "res://locale/strings.en.translation")
locale/fallback="ko"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="player_projectile"
2d_physics/layer_4="enemy_projectile"
2d_physics/layer_5="pickup"
2d_physics/layer_6="world"

[physics]

common/physics_ticks_per_second=60

[rendering]

; 모바일 우선. 2D 라이팅과 글로우가 필요해서 gl_compatibility 대신 mobile(Vulkan)을 쓴다.
; 저사양 기기는 Settings 의 저사양 프리셋으로 글로우/라이팅을 끈다.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.15, 0.17, 0.13, 1)
